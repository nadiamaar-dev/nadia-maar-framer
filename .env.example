# Copiare in .env e riempire. Nessun valore reale in questo file: sta in
# repository, .env no.
#
# Le due variabili qui sotto arrivano nel bundle del browser (prefisso VITE_)
# e sono pubbliche per costruzione: la chiave anon è pensata per stare in
# pagina, ed è la row-level security su Postgres a decidere che cosa può
# leggere. Non metterci mai la service_role key.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
